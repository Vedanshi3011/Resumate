# Copy to client/.env for local development only if you are not using the Vite proxy.
# Leave it unset in development so requests go to /api and Vite proxies to :5000.
#
# In production (Vercel/Netlify), set this to your deployed API origin:
# VITE_API_URL=https://resumate-api.onrender.com/api
VITE_API_URL=
