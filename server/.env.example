# Copy this file to server/.env and adjust.
# Local development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/resumate
JWT_SECRET=replace-this-with-a-long-random-string
CLIENT_URL=http://localhost:5173

# Production (Render/Railway/Fly)
# NODE_ENV=production
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/resumate
# JWT_SECRET=<output of: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))">
# CLIENT_URL=https://your-frontend.vercel.app

# Optional: serve the built client from Express (single-service deploy).
# Set to true after running `npm run build`. If omitted, it is enabled
# automatically when NODE_ENV=production and client/dist exists.
# SERVE_CLIENT=false
# CLIENT_DIST=/absolute/path/to/client/dist
